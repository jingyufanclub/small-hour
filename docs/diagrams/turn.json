{
  "schema_version": 1,
  "diagram_type": "sequence",
  "meta": {
    "title": "Small Hour: one turn with a tool",
    "locale": "en",
    "quality_profile": "showcase",
    "column_fit": "spread",
    "viewBox": [
      1080,
      500
    ],
    "legend": {
      "mode": "hidden"
    }
  },
  "participants": [
    {
      "id": "caller",
      "type": "backend",
      "label": "Application",
      "sublabel": "Input and context sources"
    },
    {
      "id": "turn-runtime",
      "type": "backend",
      "label": "Small Hour",
      "sublabel": "Loop and execution limits"
    },
    {
      "id": "provider-model",
      "type": "external",
      "label": "Model provider",
      "sublabel": "Through the selected adapter"
    },
    {
      "id": "host-tools",
      "type": "security",
      "label": "Application tools",
      "sublabel": "Permission and domain effects"
    }
  ],
  "messages": [
    {
      "id": "supply-request",
      "from": "caller",
      "to": "turn-runtime",
      "y": 160,
      "label": "turn({ agentId, input })",
      "variant": "emphasis"
    },
    {
      "id": "load-context",
      "from": "turn-runtime",
      "to": "caller",
      "y": 188,
      "label": "Load instructions + memory"
    },
    {
      "id": "selected-context",
      "from": "caller",
      "to": "turn-runtime",
      "y": 216,
      "label": "Fresh selected context",
      "variant": "return"
    },
    {
      "id": "first-call",
      "from": "turn-runtime",
      "to": "provider-model",
      "y": 244,
      "label": "Admit call 1: context + tool schemas",
      "variant": "emphasis"
    },
    {
      "id": "tool-request",
      "from": "provider-model",
      "to": "turn-runtime",
      "y": 272,
      "label": "tool_use + call ID + usage",
      "variant": "return"
    },
    {
      "id": "checked-dispatch",
      "from": "turn-runtime",
      "to": "host-tools",
      "y": 300,
      "label": "Record usage; check + run tool",
      "variant": "security"
    },
    {
      "id": "tool-result",
      "from": "host-tools",
      "to": "turn-runtime",
      "y": 328,
      "label": "Result + same tool call ID",
      "variant": "return"
    },
    {
      "id": "second-call",
      "from": "turn-runtime",
      "to": "provider-model",
      "y": 356,
      "label": "Admit call 2: include tool result",
      "variant": "emphasis"
    },
    {
      "id": "terminal-output",
      "from": "provider-model",
      "to": "turn-runtime",
      "y": 384,
      "label": "end_turn + final text + usage",
      "variant": "return"
    },
    {
      "id": "accepted-result",
      "from": "turn-runtime",
      "to": "caller",
      "y": 412,
      "label": "Record usage; checked result + report",
      "variant": "return"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "One turn, multiple calls",
      "items": [
        "The same deadline covers context, tools and calls.",
        "Each provider retry consumes another attempt."
      ]
    },
    {
      "dot": "rose",
      "title": "Limits stop further work",
      "items": [
        "Tools need room for a following model call.",
        "Cancellation cannot undo an effect already started."
      ]
    },
    {
      "dot": "violet",
      "title": "Structured-output alternative",
      "items": [
        "One successful response, no tools in that turn.",
        "The application's parser accepts or rejects the data."
      ]
    }
  ]
}
