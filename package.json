{
  "name": "small-hour",
  "version": "0.5.0",
  "private": true,
  "description": "A provider-neutral TypeScript runtime for application-defined LLM workflows, with tool execution, saved progress, spending controls, and recovery from failures.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./providers/anthropic": {
      "types": "./dist/providers/anthropic.d.ts",
      "import": "./dist/providers/anthropic.js"
    },
    "./providers/openai": {
      "types": "./dist/providers/openai.d.ts",
      "import": "./dist/providers/openai.js"
    },
    "./providers/openai-compatible": {
      "types": "./dist/providers/openai-compatible.d.ts",
      "import": "./dist/providers/openai-compatible.js"
    },
    "./durable/sqlite": {
      "types": "./dist/durable/sqlite.d.ts",
      "import": "./dist/durable/sqlite.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:package": "node scripts/check-package.mjs"
  },
  "engines": {
    "node": ">=26.10.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "openai": "7.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3"
  }
}
